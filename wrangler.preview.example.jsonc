{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Copy to ignored wrangler.preview.jsonc and fill in the account/D1/Clerk values.
  "name": "planwatch-v2-preview",
  "account_id": "REPLACE_WITH_ACCOUNT_ID",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "LOCAL_DEV": "false",
    "CLERK_ISSUER_URL": "https://REPLACE.clerk.accounts.dev",
    "CLERK_OWNER_USER_ID": "REPLACE_WITH_YOUR_USER_ID",
    "APP_ORIGIN": "https://REPLACE_WITH_PAGES_HOSTNAME",
    "API_ORIGIN": "https://REPLACE_WITH_WORKER_HOSTNAME"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "planwatch-v2-preview",
    "database_id": "REPLACE_WITH_PREVIEW_D1_ID",
    "migrations_dir": "migrations"
  }]
}
