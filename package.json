{
  "name": "planwatch-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5174 --strictPort",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "@lucide/vue": "latest",
    "pdf-lib": "^1.17.1",
    "vue": "3.5.44",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.5",
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "^3.0.0",
    "wrangler": "4.151.2"
  }
}
