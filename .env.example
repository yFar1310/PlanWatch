# Public frontend key only. Never put a Clerk secret key in a VITE_ variable.
# With no key, loopback development keeps the local preview; hosted APIs remain protected.
VITE_CLERK_PUBLISHABLE_KEY=

# Set for a Pages build pointing to a separate Worker. Local development uses /api.
# VITE_API_BASE_URL=https://your-api.your-account.workers.dev/api
