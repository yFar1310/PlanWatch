# server/.env.example
HOST=0.0.0.0
PORT=3000

# Opt in only to populate a disposable demo installation.
# Ordinary startup preserves your existing accounts and tasks.
SEED_DEMO_DATA=false

# Postgres
POSTGRES_URL=postgres://app:app@localhost:5432/appdb

# Mongo
MONGO_URL=mongodb://localhost:27017/planwatch

# CORS (front dev)
CORS_ORIGIN=http://localhost:5173
